[Unit]
Description=Load custom MSI-EC module for fan control
After=multi-user.target
Before=graphical.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Note: Module removal is now handled by the wrapper script (msi-ec-load.sh)
# for better error handling and logging
# Cargar módulo personalizado usando script con validación
ExecStart=/home/manusoftar/Git/msi-ec/msi-ec-load.sh
# Descargar módulo al apagar
ExecStop=/sbin/rmmod msi_ec

[Install]
WantedBy=multi-user.target
